{
    "name": "obsidian-sample-plugin",
    "version": "1.0.1",
    "description": "This is a sample plugin for Obsidian (https://obsidian.md)",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "vite build --watch --mode development",
        "build": "vite build --mode production",
        "build:check": "tsc -noEmit -skipLibCheck && vite build --mode production",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "pub": "node publish.mjs",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@qiyangxy/tedb-electron-storage": "file:package/tedb-electron-storage",
        "@vueuse/core": "^14.4.0",
        "ac-auto": "^2.0.0",
        "dexie": "^4.4.6",
        "dexie-export-import": "^4.4.1",
        "downloadjs": "^1.4.7",
        "graceful-fs": "^4.2.11",
        "monkey-around": "^3.0.0",
        "nlcst-to-string": "^4.0.0",
        "parse-english": "^7.0.0",
        "retext-english": "^5.0.0",
        "sql.js": "^1.14.2",
        "tedb-utils": "^0.0.1",
        "ts-fsrs": "^5.4.2",
        "unified": "^11.0.5",
        "unist-util-modify-children": "^4.0.0",
        "unist-util-visit": "^5.1.0",
        "vue": "^3.5.43"
    },
    "devDependencies": {
        "@types/downloadjs": "^1.4.6",
        "@types/node": "^25.9.8",
        "@types/sql.js": "^1.4.11",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@typescript-eslint/parser": "^8.71.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.8.1",
        "builtin-modules": "^5.4.0",
        "fake-indexeddb": "^6.2.5",
        "happy-dom": "^20.14.5",
        "hash-sum": "^2.0.0",
        "moment": "^2.31.0",
        "naive-ui": "^2.45.3",
        "obsidian": "^1.13.1",
        "oxlint": "^1.86.0",
        "sass": "^1.105.0",
        "terser": "^5.51.2",
        "tslib": "2.8.1",
        "typescript": "5.9.3",
        "vite": "^8.3.1",
        "vitest": "^5.0.2",
        "vue-tsc": "^3.3.11"
    }
}
